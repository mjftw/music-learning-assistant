# Cloudflare Pages response headers (docs/deploy.md). Vite copies this file
# from src/ui/public/ to the root of dist/ unchanged.

# Hashed build output: the name changes whenever the content does.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The entry page must be revalidated so a new deploy is picked up at once.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
